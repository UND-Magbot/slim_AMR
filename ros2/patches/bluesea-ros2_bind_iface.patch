@@ -1,3 +1,5 @@
+#include <stdlib.h>
+#include <string.h>
 #include "../include/alarm.h"
 #include "../include/reader.h"
 
@@ -311,6 +313,17 @@ HReader StartUDPReader(const char *type, unsigned short listen_port, bool is_gro
 	int one = 1;
 	setsockopt(info->fd_udp, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
 
+	// UND_AMR 2026-10-23: 라이다 2대가 둘 다 공장 IP 192.168.158.98 이고 각각 다른
+	// 랜 포트(enp2s0 / eno1)에 꽂혀 있다. IP 로는 못 가르니 랜 포트로 가른다.
+	// LIDAR_BIND_IFACE=eno1 이면 이 소켓은 그 포트로만 받고 보낸다. 같은 수신
+	// 포트(6668)에 소켓이 여럿이어도 커널은 포트가 지정된 소켓에 먼저 넘긴다.
+	const char *bind_if = getenv("LIDAR_BIND_IFACE");
+	if (bind_if && bind_if[0])
+	{
+		int rb = setsockopt(info->fd_udp, SOL_SOCKET, SO_BINDTODEVICE, bind_if, strlen(bind_if));
+		printf("bind udp socket to %s %s\n", bind_if, rb == 0 ? "ok" : "FAILED");
+	}
+
 	sockaddr_in addr;
 	addr.sin_family = AF_INET;
 	addr.sin_port = htons(listen_port);
