{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make -j$(nproc)",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Flash (OpenOCD)",
            "type": "shell",
            "command": "make flash",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build",
            "problemMatcher": []
        },
        {
            "label": "Flash (st-flash)",
            "type": "shell",
            "command": "make flash-st",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build",
            "problemMatcher": []
        }
    ]
}
